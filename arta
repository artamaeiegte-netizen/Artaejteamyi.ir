            const t = document.getElementById('toast');
            t.textContent = msg; t.classList.add('show');
            clearTimeout(toast._t); toast._t = setTimeout(() => t.classList.remove('show'), 3500);
        }
        function faDigits(s) {
            return String(s).replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d)).replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d));
        }
        function validPhone(p) { return /^(\+98|0098|98|0)?9\d{9}$/.test(faDigits(p).replace(/[\s-]/g, '')); }
        function sendWA(text) { window.open('https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(text), '_blank', 'noopener'); }

        // ===== ناوبری =====
        function currentId() {
            try { return decodeURIComponent(window.location.hash.replace('#', '')) || 'home'; } catch (e) { return 'home'; }
        }
        function closeMenu() {
            document.getElementById('mainNav').classList.remove('open');
            document.getElementById('navToggle').setAttribute('aria-expanded', 'false');
        }
        function toggleMenu() {
            const open = document.getElementById('mainNav').classList.toggle('open');
            document.getElementById('navToggle').setAttribute('aria-expanded', String(open));
        }
        function renderSection(id) {
            let target = null;
            document.querySelectorAll('section').forEach(sec => {
                sec.classList.remove('active'); sec.style.display = 'none';
                if (sec.id === id) target = sec;
            });
            if (!target) target = document.getElementById('home');
            target.style.display = 'flex';
            setTimeout(() => target.classList.add('active'), 10);
            if (target.id === 'admin-section') checkLoginStatus();
            closeMenu();
            window.scrollTo(0, 0);
        }
        function showSection(id) {
            if (window.location.hash !== '#' + id) window.location.hash = id;
            else renderSection(id);
            return false;
        }
        window.addEventListener('hashchange', () => renderSection(currentId()));
        // میانبر ورود ادمین: Ctrl + Alt + E (مستقل از زبان کیبورد)
        document.addEventListener('keydown', e => {
            if (e.ctrlKey && e.altKey && e.code === 'KeyE') { e.preventDefault(); showSection('admin-section'); }
        });
        function enroll(course) {
            document.getElementById('service').value = 'آموزش کامپیوتر';
            document.getElementById('details').value = 'می‌خوام برای «' + course + '» ثبت‌نام کنم.';
            showSection('contact');
        }

        // ذرات معلق (فقط دسکتاپ و بدون ترجیح کاهش انیمیشن)
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.innerWidth > 768) {
            const box = document.getElementById('particles');
            for (let i = 0; i < 12; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                p.style.left = Math.random() * 100 + 'vw';
                p.style.width = p.style.height = Math.random() * 10 + 5 + 'px';
                p.style.animationDuration = Math.random() * 10 + 10 + 's';
                p.style.animationDelay = Math.random() * 5 + 's';
                box.appendChild(p);
            }
        }

        // ===== فرم‌ها: ارسال از طریق واتساپ =====
        document.getElementById('ticketForm').addEventListener('submit', function (e) {
            e.preventDefault();
            if (this.elements.website.value) return;
            const phone = document.getElementById('tPhone').value;
            if (!validPhone(phone)) { toast('شماره تماس معتبر نیست'); return; }
            sendWA('🎫 تیکت پشتیبانی\nنام: ' + document.getElementById('tName').value.trim() +
                '\nتماس: ' + faDigits(phone).trim() +
                '\nنوع: ' + document.getElementById('ticketType').value +
                '\nتوضیحات: ' + document.getElementById('ticketDetails').value.trim());
            this.reset();
            toast('واتساپ باز شد؛ پیام رو ارسال کن تا به دستم برسه');
            showSection('home');
        });
        document.getElementById('orderForm').addEventListener('submit', function (e) {
            e.preventDefault();
            if (this.elements.website.value) return;
            const phone = document.getElementById('phone').value;
            if (!validPhone(phone)) { toast('شماره تماس معتبر نیست'); return; }
            sendWA('🛍️ درخواست جدید (' + document.getElementById('service').value + ')\nنام: ' +
                document.getElementById('name').value.trim() + '\nتماس: ' + faDigits(phone).trim() +
                '\nتوضیحات: ' + document.getElementById('details').value.trim());
            this.reset();
            toast('واتساپ باز شد؛ پیام رو ارسال کن تا به دستم برسه');
            showSection('home');
        });

        // ===== پنل ادمین (سمت مرورگر؛ برای پیش‌نمایش محلی) =====
        async function sha256(str) {
            const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
            return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
        }
        function checkLoginStatus() {
            const logged = sessionStorage.getItem('artaAdminLogged') === 'true';
            document.getElementById('loginBox').style.display = logged ? 'none' : 'block';
            document.getElementById('adminPanelContent').style.display = logged ? 'block' : 'none';
            document.getElementById('loginHint').textContent = localStorage.getItem(LS.hash)
                ? 'ورود ادمین' : 'اولین ورود: یک رمز عبور (حداقل ۸ کاراکتر) تعیین کن';
            if (logged) loadAdsInputs();
        }
        async function checkLogin() {
            if (!window.crypto || !crypto.subtle) { toast('برای ورود به پنل، سایت باید با HTTPS باز شود'); return; }
            const pass = document.getElementById('adminPass').value;
            const stored = localStorage.getItem(LS.hash);
            if (!stored) {
                if (pass.length < 8) { toast('رمز باید حداقل ۸ کاراکتر باشد'); return; }
                safeSet(LS.hash, await sha256(pass));
            } else if (await sha256(pass) !== stored) {
                toast('رمز عبور اشتباه است'); return;
            }
            sessionStorage.setItem('artaAdminLogged', 'true');
            document.getElementById('adminPass').value = '';
            checkLoginStatus();
        }
        function logout() {
            sessionStorage.removeItem('artaAdminLogged');
            checkLoginStatus();
            showSection('home');
        }
        async function changePassword() {
            const np = document.getElementById('newPassword').value;
            if (np.length < 8) { toast('رمز باید حداقل ۸ کاراکتر باشد'); return; }
            safeSet(LS.hash, await sha256(np));
            document.getElementById('newPassword').value = '';
            toast('رمز تغییر کرد'); logout();
        }
        function switchTab(name, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            ['addContent', 'manageAds', 'security'].forEach(t => {
                document.getElementById('tab-' + t).style.display = t === name ? 'block' : 'none';
            });
        }

        // ===== محتوای عمومی =====
        function safeImgSrc(s) {
            return typeof s === 'string' && (/^data:image\/(png|jpe?g|webp|gif);base64,/.test(s) ||
                /^https?:\/\//i.test(s) || /^[\w./-]+\.(png|jpe?g|webp|gif|svg)$/i.test(s));
        }
        function buildCard(item) {
            const d = document.createElement('div');
            d.className = 'glass-box preview-card';
            d.style.cssText = 'padding:0; overflow:hidden';
            if (safeImgSrc(item.image)) {
                const im = document.createElement('img');
                im.src = item.image; im.alt = item.title || ''; im.loading = 'lazy';
                d.appendChild(im);
            } else {
                const ph = document.createElement('div');
                ph.style.cssText = 'width:100%; height:200px; background:rgba(255,255,255,0.05); display:flex; align-items:center; justify-content:center; color:#777;';
                ph.textContent = 'بدون تصویر';
                d.appendChild(ph);
            }
            const body = document.createElement('div');
            body.style.cssText = 'padding:20px; text-align:right;';
            const h = document.createElement('h3');
            h.style.cssText = 'color:var(--primary); margin-bottom:10px;'; h.textContent = item.title || '';
            const p = document.createElement('p');
            p.style.fontSize = '0.9rem'; p.textContent = item.desc || '';
            body.append(h, p); d.appendChild(body);
            return d;
        }
        function loadPublicContent() {
            const map = { project: 'publicProjectsContainer', article: 'publicArticlesContainer', blog: 'publicBlogContainer' };
            const items = [...SITE_CONFIG.content, ...safeGetJSON(LS.content, [])];
            Object.entries(map).forEach(([type, id]) => {
                const box = document.getElementById(id);
                box.replaceChildren();
                items.filter(i => i && i.type === type).forEach(i => box.appendChild(buildCard(i)));
                if (!box.children.length) {
                    const p = document.createElement('p');
                    p.style.cssText = 'color:#888; grid-column: 1 / -1;';
                    p.textContent = 'به‌زودی محتوای جدید اینجا منتشر می‌شود.';
                    box.appendChild(p);
                }
            });
        }
        function compressImage(file) {
            return new Promise((resolve, reject) => {
                const img = new Image(); const url = URL.createObjectURL(file);
                img.onload = () => {
                    const r = Math.min(1, 900 / Math.max(img.width, img.height));
                    const c = document.createElement('canvas');
                    c.width = Math.round(img.width * r); c.height = Math.round(img.height * r);
                    c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
                    URL.revokeObjectURL(url); resolve(c.toDataURL('image/jpeg', 0.8));
                };
                img.onerror = reject; img.src = url;
            });
        }
        async function addNewContent() {
            const type = document.getElementById('contentType').value;
            const title = document.getElementById('newContentTitle').value.trim();
            const desc = document.getElementById('newContentDesc').value.trim();
            const file = document.getElementById('contentImage').files[0];
            if (!title || !desc) { toast('عنوان و توضیحات را پر کن'); return; }
            let image = null;
            if (file) { try { image = await compressImage(file); } catch (e) { toast('تصویر خوانده نشد'); return; } }
            const data = safeGetJSON(LS.content, []);
            data.push({ type, title, desc, image, id: Date.now() });
            if (!safeSet(LS.content, JSON.stringify(data))) { toast('حافظه مرورگر پر است؛ تصویر کوچک‌تری انتخاب کن'); return; }
            ['newContentTitle', 'newContentDesc', 'contentImage'].forEach(i => document.getElementById(i).value = '');
            toast('در پیش‌نمایش همین مرورگر ذخیره شد');
            loadPublicContent();
        }
        function clearLocalContent() {
            if (confirm('همه محتوای ذخیره‌شده در این مرورگر پاک شود؟')) { localStorage.removeItem(LS.content); loadPublicContent(); }
        }

        // ===== تبلیغات =====
        function getAds() {
            const a = safeGetJSON(LS.ads, null);
            return Array.isArray(a) && a.length === 3 && a.every(x => x && typeof x.text === 'string') ? a : SITE_CONFIG.ads;
        }
        function loadAdsData() {
            getAds().forEach((ad, i) => {
                const b = document.getElementById('adBanner' + (i + 1));
                if (!b) return;
                b.textContent = ad.text;
                if (/^https?:\/\//i.test(ad.link || '')) {
                    b.href = ad.link; b.target = '_blank'; b.rel = 'noopener sponsored'; b.style.cursor = 'pointer';
                } else {
                    b.removeAttribute('href'); b.removeAttribute('target'); b.style.cursor = 'default';
                }
            });
        }
        function loadAdsInputs() {
            getAds().forEach((ad, i) => {
                document.getElementById('adText' + (i + 1)).value = ad.text;
                document.getElementById('adLink' + (i + 1)).value = ad.link || '';
            });
        }
        function updateAdsData() {
            const ads = [1, 2, 3].map(i => ({
                text: document.getElementById('adText' + i).value.trim(),
                link: document.getElementById('adLink' + i).value.trim()
            }));
            if (ads.some(a => !a.text)) { toast('متن بنر نباید خالی باشد'); return; }
            if (ads.some(a => a.link && !/^https?:\/\//i.test(a.link))) { toast('لینک باید با http:// یا https:// شروع شود'); return; }
            safeSet(LS.ads, JSON.stringify(ads));
            toast('ذخیره شد (فقط در این مرورگر)');
            loadAdsData();
        }

        document.addEventListener('click', e => { if (!e.target.closest('header')) closeMenu(); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
        document.addEventListener('DOMContentLoaded', () => {
            loadPublicContent();
            loadAdsData();
            renderSection(currentId());
        });
    </script>
</body>
</html>
